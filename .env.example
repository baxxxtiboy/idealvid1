# ====== GLASS-IDEAL_VITRAJ sozlamalari ======
# Nusxa oling:  .env  nomi bilan saqlang (nuqta bilan boshlanadi)

# BotFather bergan token (Telegram bot kerak bo'lmasa bo'sh qoldiring — sayt baribir ishlaydi)
BOT_TOKEN=

# Saytingizning ochiq HTTPS manzili (Render bergan manzil). Lokalda bo'sh qoldiring.
PUBLIC_URL=

# MongoDB Atlas (bepul) ulanish manzili — Render'da ma'lumot yo'qolmasligi uchun KERAK
MONGODB_URI=

# Admin paroli (birinchi ishga tushganda yaratiladi). Bo'sh bo'lsa: admin1414
ADMIN_PASSWORD=

# Ixtiyoriy: tokenlar uchun maxfiy kalit (uzun tasodifiy matn)
SECRET=
